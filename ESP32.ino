// lat/lon -> pixel position on the map (home at the centre), no clamping
void toMapRaw(double lat, double lon, int cx, int cy, int R, float &x, float &y) {
  double dxKm = (lon - HOME_LON) * 111.320 * cos(radians(HOME_LAT));
  double dyKm = (lat - HOME_LAT) * 110.574;
  float scale = R / (RADIUS_NM * 1.852f);
  x = cx + (float)(dxKm * scale);
  y = cy - (float)(dyKm * scale);
}

// same, but clamped inside the outer ring (used for aircraft)
void toMap(double lat, double lon, int cx, int cy, int R, float &x, float &y) {
  toMapRaw(lat, lon, cx, cy, R, x, y);
  float ddx = x - cx, ddy = y - cy;
  float d = sqrtf(ddx * ddx + ddy * ddy);
  float maxR = R - 3;
  if (d > maxR) { x = cx + ddx * maxR / d; y = cy + ddy * maxR / d; }
}

void fmtCoord(char* buf, size_t n, const char* prefix, double lat, double lon) {
  snprintf(buf, n, "%s %.4f%c %.4f%c", prefix, fabs(lat), lat >= 0 ? 'N' : 'S',
           fabs(lon), lon >= 0 ? 'E' : 'W');
}

void drawDottedCircle(int cx, int cy, int r, int gapPx, uint16_t color) {
  int steps = (int)(2 * PI * r / gapPx);
  for (int i = 0; i < steps; i++) {
    float a = i * 2 * PI / steps;
    tft.fillRect(cx + (int)lroundf(r * cosf(a)), cy + (int)lroundf(r * sinf(a)), 2, 2, color);
  }
}

void drawDiamond(int x, int y, int r, uint16_t color) {
  tft.fillTriangle(x, y - r, x + r, y, x, y + r, color);
  tft.fillTriangle(x, y - r, x - r, y, x, y + r, color);
}

// heading line: dark outline underneath, amber line on top (readable on any map)
void drawHeadingLine(int x0, int y0, int x1, int y1) {
  for (int dx = -1; dx <= 1; dx++)
    for (int dy = -1; dy <= 1; dy++)
      tft.drawLine(x0 + dx, y0 + dy, x1 + dx, y1 + dy, C_BG);
  tft.drawLine(x0, y0, x1, y1, C_ACCENT);
  tft.drawLine(x0 + 1, y0, x1 + 1, y1, C_ACCENT);       // 2 px wide
  tft.drawLine(x0, y0 + 1, x1, y1 + 1, C_ACCENT);
}

void drawMap(const Flight &fl) {
  const int mx = 164, my = 82;
  const int mw = MAP_IMG_W, mh = MAP_IMG_H;
  const int cx = mx + mw / 2, cy = my + mh / 2;
  const int R = MAP_IMG_R;

#if HAVE_MAP
  tft.pushImage(mx, my, mw, mh, MAP_IMG);
#else
  tft.fillRect(mx, my, mw, mh, C_CARD);
#endif
  tft.drawRect(mx - 1, my - 1, mw + 2, mh + 2, C_DIM);

  // range rings (dotted; dark on light maps, light on dark maps)
  uint16_t ringCol = MAP_IMG_LIGHT ? C_CARD : C_MUTED;
  drawDottedCircle(cx, cy, R, 6, ringCol);
  drawDottedCircle(cx, cy, R / 2, 10, ringCol);

  // labels with their own dark background, readable on any map
  tft.setTextDatum(MC_DATUM);
  tft.fillCircle(cx, my + 8, 7, C_BG);
  tft.setTextColor(C_WHITE, C_BG);
  tft.drawString("N", cx, my + 8, 1);
  tft.setTextColor(C_MUTED, C_BG);
  tft.setTextDatum(TR_DATUM);
  tft.drawString(String(RADIUS_NM) + " nm", mx + mw - 3, my + 3, 1);
  tft.setTextDatum(BL_DATUM);
  tft.drawString(MAP_IMG_ATTRIBUTION, mx + 3, my + mh - 2, 1);

  // airports: violet diamonds with their code (only if they fall inside the map)
  if (SHOW_AIRPORTS) {
    for (int i = 0; i < AIRPORT_N; i++) {
      float sx, sy;
      toMapRaw(AIRPORTS[i].lat, AIRPORTS[i].lon, cx, cy, R, sx, sy);
      int apx = (int)lroundf(sx), apy = (int)lroundf(sy);
      if (apx < mx + 7 || apx > mx + mw - 7 || apy < my + 7 || apy > my + mh - 7) continue;
      drawDiamond(apx, apy, 5, C_BG);                 // dark rim
      drawDiamond(apx, apy, 3, C_AIRPORT);
      bool labelRight = (apx + 8 + 18 < mx + mw - 2);  // 3 letters = 18 px wide
      tft.setTextColor(C_AIRPORT, C_BG);
      tft.setTextDatum(labelRight ? ML_DATUM : MR_DATUM);
      tft.drawString(AIRPORTS[i].code, labelRight ? apx + 8 : apx - 8, apy, 1);
    }
  }

  // other aircraft (small white dots with a dark rim), skipping the nearest one
  for (int i = 0; i < dotN; i++) {
    if (i == bestDot) continue;
    float ox, oy;
    toMap(dotLat[i], dotLon[i], cx, cy, R, ox, oy);
    tft.fillCircle((int)ox, (int)oy, 3, C_BG);
    tft.fillCircle((int)ox, (int)oy, 2, C_WHITE);
  }

  // nearest aircraft: amber dot with a heading line
  float ax, ay;
  toMap(fl.lat, fl.lon, cx, cy, R, ax, ay);
  int px = (int)lroundf(ax), py = (int)lroundf(ay);

  if (fl.hasTrack) {
    float a = radians(fl.track);
    int len = HEADING_LINE_PX;
    int ex, ey;
    while (true) {                                  // shorten the line until it stays inside the map
      ex = px + (int)lroundf(len * sinf(a));
      ey = py - (int)lroundf(len * cosf(a));
      if (ex > mx + 3 && ex < mx + mw - 4 && ey > my + 3 && ey < my + mh - 4) break;
      len -= 2;
      if (len < 6) { ex = px; ey = py; break; }
    }
    drawHeadingLine(px, py, ex, ey);
  }
  tft.fillCircle(px, py, 6, C_BG);                  // dark rim
  tft.fillCircle(px, py, 4, C_ACCENT);

  // home marker
  tft.fillCircle(cx, cy, 6, C_BG);
  tft.fillCircle(cx, cy, 3, C_CYAN);

  // coordinates under the map
  if (SHOW_COORDS) {
    char line[40];
    tft.setTextDatum(TL_DATUM);
    fmtCoord(line, sizeof(line), "HOME", HOME_LAT, HOME_LON);
    tft.setTextColor(C_CYAN, C_BG);
    tft.drawString(line, mx, 216, 1);
    fmtCoord(line, sizeof(line), "A/C ", fl.lat, fl.lon);
    tft.setTextColor(C_ACCENT, C_BG);
    tft.drawString(line, mx, 225, 1);
  }
}

void drawFlight(const Flight &fl, int count, bool error) {
  tft.fillRect(0, 24, 320, 216, C_BG);

  if (error) {
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_RED, C_BG);
    tft.drawString("Connection problem", 160, 105, 4);
    tft.setTextColor(C_MUTED, C_BG);
    tft.drawString("retrying shortly...", 160, 140, 2);
    return;
  }
  if (!fl.valid) {
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_WHITE, C_BG);
    tft.drawString("Clear skies", 160, 105, 4);
    tft.setTextColor(C_MUTED, C_BG);
    tft.drawString("nothing below " + String(MAX_ALT_FT) + " ft within " + String(RADIUS_NM) + " nm", 160, 140, 2);
    return;
  }

  // row 1: callsign (left) and route (right), same baseline
  const char* cs = strlen(fl.callsign) ? fl.callsign : "-------";
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(C_ACCENT, C_BG);
  tft.drawString(cs, 8, 28, 4);

  if (SHOW_ROUTE) {
    tft.setTextDatum(TR_DATUM);
    if (fl.routeKnown) {
      tft.setTextColor(C_WHITE, C_BG);
      tft.drawString(String(fl.origin) + " > " + fl.dest, 312, 28, 4);
    } else {
      tft.setTextColor(C_MUTED, C_BG);
      tft.drawString("route unknown", 312, 34, 2);
    }
  }

  // row 2: airline (left) and city names (right)
  if (SHOW_ROUTE && fl.routeKnown) {
    char al[24], oc[24], dc[24];
    strlcpy(al, fl.airline, sizeof(al));        shorten(al, 16);
    strlcpy(oc, fl.originCity, sizeof(oc));     shorten(oc, 10);
    strlcpy(dc, fl.destCity, sizeof(dc));       shorten(dc, 10);
    tft.setTextColor(C_MUTED, C_BG);
    tft.setTextDatum(TL_DATUM);
    tft.drawString(al, 8, 58, 2);
    if (oc[0] && dc[0]) {
      tft.setTextDatum(TR_DATUM);
      tft.drawString(String(oc) + " > " + dc, 312, 58, 2);
    }
  }
  tft.drawFastHLine(8, 78, 304, C_CARD);

  // left column: stats
  String alt = fl.onGround ? String("GND") : String(fl.altFt);
  drawStat(8, 82,  148, "ALT ft",  alt, C_GREEN);
  drawStat(8, 122, 148, "SPD kt",  String(fl.speedKt), C_CYAN);
  drawStat(8, 162, 148, "DIST km", String(fl.distKm, 1), C_WHITE);

  String left = strlen(fl.type) ? String(fl.type) : String("?");
  if (strlen(fl.reg)) left += " - " + String(fl.reg);
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(C_WHITE, C_BG);
  tft.drawString(left, 8, 203, 2);
  tft.setTextColor(C_MUTED, C_BG);
  tft.drawString(String(count) + " below " + String(MAX_ALT_FT / 1000) + "k ft", 8, 223, 1);

  // right column: map
  drawMap(fl);
}

// ---------- phone notifications (ntfy) ----------
const int NOTIFIED_N = 12;                      // how many recently notified aircraft we remember
char notifiedId[NOTIFIED_N][12];
unsigned long notifiedAt[NOTIFIED_N];
bool notifiedUsed[NOTIFIED_N];
unsigned long lastNotifyMs = 0;
bool anyNotified = false;

const char* compassPoint(float b) {
  static const char* d[] = {"N", "NE", "E", "SE", "S", "SW", "W", "NW"};
  return d[(int)((b + 22.5f) / 45.0f) % 8];
}

// Sends one message to the ntfy topic. Returns true if the server accepted it.
bool sendNtfy(const String &title, const String &body, const char* priority, const char* tags) {
  if (WiFi.status() != WL_CONNECTED) return false;

  String url = NTFY_URL;
  bool https = url.startsWith("https://");

  WiFiClientSecure secureClient;
  WiFiClient plainClient;
  HTTPClient http;
  http.setTimeout(8000);
  http.setUserAgent("esp32-flight-panel/1.0");

  bool began;
  if (https) {
    secureClient.setInsecure();                 // no certificate check, like the other requests
    began = http.begin(secureClient, url);
  } else {
    began = http.begin(plainClient, url);
  }
  if (!began) {
    Serial.println("ntfy: connection setup failed");
    return false;
  }

  http.addHeader("Title", title);
  http.addHeader("Priority", priority);
  http.addHeader("Tags", tags);
  http.addHeader("Content-Type", "text/plain; charset=utf-8");
#ifdef NTFY_TOKEN
  http.addHeader("Authorization", String("Bearer ") + NTFY_TOKEN);
#endif

  int code = http.POST(body);
  String detail = (code > 0) ? http.getString() : http.errorToString(code);
  http.end();

  bool ok = (code == 200);
  if (ok) Serial.println("ntfy: notification sent");
  else    Serial.printf("ntfy: failed, HTTP %d %s\n", code, detail.c_str());
  return ok;
}

bool recentlyNotified(const char* id) {
  unsigned long now = millis();
  for (int i = 0; i < NOTIFIED_N; i++) {
    if (notifiedUsed[i] && strcmp(notifiedId[i], id) == 0 &&
        (now - notifiedAt[i]) < NOTIFY_COOLDOWN_MIN * 60000UL) return true;
  }
  return false;
}

void rememberNotified(const char* id) {
  unsigned long now = millis();
  int slot = -1;

  // 1. same aircraft already in the list: refresh its entry
  for (int i = 0; i < NOTIFIED_N; i++)
    if (notifiedUsed[i] && strcmp(notifiedId[i], id) == 0) { slot = i; break; }

  // 2. otherwise use a free entry
  if (slot < 0)
    for (int i = 0; i < NOTIFIED_N; i++)
      if (!notifiedUsed[i]) { slot = i; break; }

  // 3. otherwise replace the oldest one
  if (slot < 0) {
    unsigned long maxAge = 0;
    slot = 0;
    for (int i = 0; i < NOTIFIED_N; i++) {
      unsigned long age = now - notifiedAt[i];
      if (age >= maxAge) { maxAge = age; slot = i; }
    }
  }

  strlcpy(notifiedId[slot], id, sizeof(notifiedId[slot]));
  notifiedAt[slot] = now;
  notifiedUsed[slot] = true;
}

// Called after every successful update with the nearest aircraft.
void maybeNotify(const Flight &fl) {
  if (!NOTIFY_ENABLED || !fl.valid || fl.onGround) return;
  if (fl.distKm > NOTIFY_KM || fl.altFt >= NOTIFY_MAX_ALT_FT) return;

  const char* id = fl.callsign[0] ? fl.callsign : (fl.reg[0] ? fl.reg : "unknown");
  if (recentlyNotified(id)) return;
  if (anyNotified && NOTIFY_MIN_GAP_S > 0 &&
      millis() - lastNotifyMs < NOTIFY_MIN_GAP_S * 1000UL) return;

  String title = String("Plane nearby: ") + id;

  String body;
  if (fl.routeKnown) {
    body += String(fl.origin) + " > " + fl.dest;
    if (fl.airline[0]) body += " (" + String(fl.airline) + ")";
    body += "\n";
  }
  if (fl.type[0]) {
    body += fl.type;
    if (fl.reg[0]) body += " " + String(fl.reg);
    body += "\n";
  }
  body += String(fl.altFt) + " ft, " + String(fl.speedKt) + " kt\n";
  body += String(fl.distKm, 1) + " km " + compassPoint(fl.bearing);
  if (fl.hasTrack) body += ", heading " + String((int)lroundf(fl.track)) + " deg";

  Serial.printf("Notifying about %s (%.1f km, %d ft)\n", id, fl.distKm, fl.altFt);
  if (sendNtfy(title, body, NOTIFY_PRIORITY, "airplane")) {
    rememberNotified(id);                       // only remembered if it was actually delivered
    lastNotifyMs = millis();
    anyNotified = true;
  }
}

// ---------- main ----------
unsigned long lastPoll = 0;
int lastMinute = -1;

void setup() {
  Serial.begin(115200);

  // wake-up handling: after a timer wake-up keep the screen dark until we know it's morning
  bool timerWake = (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_TIMER);
  gpio_deep_sleep_hold_dis();
  gpio_hold_dis((gpio_num_t)BACKLIGHT_PIN);

  pinMode(BACKLIGHT_PIN, OUTPUT);
  digitalWrite(BACKLIGHT_PIN, timerWake ? LOW : HIGH);

  tft.init();
  tft.setRotation(1);
  tft.setSwapBytes(true);                          // needed to draw the map image correctly
  initColors();
  tft.fillScreen(C_BG);
  if (!timerWake) drawHeader(TFT_ORANGE);

  connectWiFi();
  configTzTime(TZ_PARIS, "pool.ntp.org", "time.google.com");

  struct tm t;
  bool haveTime = getLocalTime(&t, 10000);         // wait up to 10 s for NTP
  if (haveTime && inSleepWindow(t.tm_hour)) {
    goToSleep(sleepChunk(secondsUntilWake(t)), !timerWake);
  } else if (!haveTime && timerWake) {
    goToSleep(600, false);                         // no clock yet: retry in 10 min, screen stays off
  }

  if (timerWake) {                                 // it's morning: turn the screen on
    digitalWrite(BACKLIGHT_PIN, HIGH);
    drawHeader(TFT_ORANGE);
  }

  if (NOTIFY_ENABLED && NOTIFY_STARTUP_TEST) {
    sendNtfy("Skywatch online",
             "Notifications work. Alerts fire within " + String(NOTIFY_KM, 1) + " km, below " +
             String(NOTIFY_MAX_ALT_FT) + " ft.",
             "low", "white_check_mark");
  }

  lastResetMs = millis();
  lastPoll = millis() - POLL_MS;                   // poll immediately
}

void loop() {
  struct tm t;
  if (getLocalTime(&t, 0) && t.tm_min != lastMinute) {
    lastMinute = t.tm_min;
    if (inSleepWindow(t.tm_hour)) {
      goToSleep(sleepChunk(secondsUntilWake(t)), true);
    }
    drawHeader(statusColor);                       // refresh the clock
  }

  if (millis() - lastPoll < POLL_MS) return;
  lastPoll = millis();

  resetBudgetsIfNewDay();

  if (WiFi.status() != WL_CONNECTED) {
    drawHeader(C_RED);
    connectWiFi();
  }
  if (WiFi.status() != WL_CONNECTED) return;

  drawHeader(TFT_ORANGE);
  Flight fl;
  int n = fetchNearest(fl);

  if (n == -2) {                                   // all providers waiting: keep last screen
    drawHeader(C_ACCENT);
    return;
  }
  if (n < 0) {
    drawHeader(C_RED);
    drawFlight(fl, 0, true);
    return;
  }

  if (SHOW_ROUTE && fl.valid && strlen(fl.callsign) >= 3) {
    lookupRoute(fl.callsign);
    RouteEntry* r = findRoute(fl.callsign);
    if (r && r->known) {
      fl.routeKnown = true;
      strlcpy(fl.origin, r->orig, sizeof(fl.origin));
      strlcpy(fl.dest, r->dest, sizeof(fl.dest));
      strlcpy(fl.originCity, r->origCity, sizeof(fl.originCity));
      strlcpy(fl.destCity, r->destCity, sizeof(fl.destCity));
      strlcpy(fl.airline, r->airline, sizeof(fl.airline));
    }
  }

  drawHeader(C_GREEN);
  drawFlight(fl, n, false);

  maybeNotify(fl);                                 // phone alert if something is really close
}